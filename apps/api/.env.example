NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://tangata:tangata@localhost:5432/tangata
WEB_ORIGIN=http://localhost:3000

# Opcional: API oficial de la CMF para UF y UTM (gratuita, se pide en cmfchile.cl)
CMF_API_KEY=
SINCRONIZACION_AUTOMATICA=true

# Secretos obligatorios. Genera cada uno con: openssl rand -base64 32
# CLAVE_CIFRADO cifra los documentos: si se pierde, los archivos no se recuperan. Guárdala en el gestor de secretos.
CLAVE_CIFRADO=
SECRETO_ENLACES=
ALMACEN_DIR=almacen
PORTAL_URL=http://localhost:3000
ALERTAS_AUTOMATICAS=true

# Exige segundo factor a Personas, Gerencia y Administración. Déjalo en true fuera de tu computador.
SEGUNDO_FACTOR_OBLIGATORIO=true
